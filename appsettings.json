{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MiniECommerceDb;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Jwt": {
    "Issuer": "MiniECommerce.Api",
    "Audience": "MiniECommerce.Client",
    "SecretKey": "SUPER_SECRET_KEY_CAMBIAR_EN_PRODUCCION",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "ConfigCache": {
    "DuracionCacheSegundos": 200
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Filters.Expressions"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },

    "Enrich": [ "FromLogContext" ],

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [CorrId={CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },

      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "@Level = 'Information'" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "Logs/Information/info-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 14,
                  "shared": true,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [CorrId={CorrelationId}] {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },

      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "@Level = 'Warning'" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "Logs/Warning/warn-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 30,
                  "shared": true,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [CorrId={CorrelationId}] {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },

      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "@Level = 'Error' or @Level = 'Fatal'" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "Logs/Error/error-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 90,
                  "shared": true,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [CorrId={CorrelationId}] {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
